<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>StyleOS</AssemblyName>
    <RootNamespace>StyleOS</RootNamespace>
    <Version>1.1.7</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Drawing.Common is Windows-only since .NET 7 and System.Management is WMI:
         the Linux build uses ImageSharp for the splash image and /proc + /sys for hardware info. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.7" />
  </ItemGroup>

</Project>
